#!/bin/bash

function check_install_ubuntu() {
    package="$1"

    dpkg-query -W -f='${Status}\n' $package 2>/dev/null | grep -q "ok installed"
    if [ "$?" -ne "0" ]; then 
        sudo apt install $package -y  &> /dev/null
        if [  "$?" -eq "0" ]; then 
            echo "📦 $package installed"
        else 
            echo "❌ Error: $package not installed."
        fi 
    else 
        echo "✅ $package exists"
    fi
}

function check_install_darwin() {
    if ! command -v brew &> /dev/null; then
        echo "⏳ Homebrew not found. Installing Homebrew..."
        
        # Run the official Homebrew installation script
        /bin/bash -c "$(curl -fsSL https://githubusercontent.com)"
        
        # Set up the environment paths immediately for the rest of this script
        # This ensures 'brew' works on both Intel and Apple Silicon Macs right away
        if [[ "$(uname -m)" == "arm64" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        else
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    else
        echo "✅ Homebrew is already installed."
    fi

    brewfile="$(chezmoi source-path)/Brewfile"
    if [ -f "$brewfile" ]; then
        echo "📦 Installing/Checking apps from Brewfile..."
        brew bundle --file "$brewfile" 
        echo "🎉 All packages and casks are up to date!"
    else
        echo "❌ Error: Brewfile not found in the current directory."
    fi

    echo "🎉 All done! Homebrew and all packages are ready."
}

function dl_font() {
    font_url="$1"

    mkdir -p /tmp/font
    curl -L $font_url -o /tmp/font/font.zip
    unzip /tmp/font/font.zip -d /tmp/font/

}

function install_fonts() {
    {{ if eq .chezmoi.os "linux" }}
        fontdir="$HOME/.local/share/fonts"
    {{ end }}

    {{ if eq .chezmoi.os "darwin" }}
        fontdir="$HOME/Library/Fonts"
    {{ end }}

    mkdir -p "$fontdir"
    cd "$fontdir"
    find . -type f -printf "✅ found %f\n" -exec rm -f /tmp/font/{} \;
    find /tmp/font -maxdepth 1 -type f \( -name "*.ttf" -o -name "*.otf" -o -name "*.ttc" -o -name "*.otc" \) -exec cp {} $HOME/.local/share/fonts \; -printf "📦 Installing %f\n"
    cd - 
    rm -rf "/tmp/font"

    {{ if eq .chezmoi.os "linux" }}
        echo "⏳ Updating font cache (this may take a moment)"
        fc-cache -f
    {{ end }}
}

#curl and zsh are installed by default on darwin
#https://www.chezmoi.io/user-guide/machines/linux/#combine-operating-system-and-linux-distribution-conditionals
{{- if eq .chezmoi.os "linux" -}}
    echo "Install for linux"

    {{- if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}

        echo "debian apt based package installs"
        check_install_ubuntu zsh
        check_install_ubuntu tmux
        check_install_ubuntu curl
        check_install_ubuntu zip
        check_install_ubuntu ghostty
        check_install_ubuntu bat
        check_install_ubuntu fzf
        check_install_ubuntu lazygit

    {{- else if eq .chezmoi.osRelease.id "fedora" -}}

        echo "fedora"
        rpm-ostree install zsh 
        rpm-ostree install tmux
        rpm-ostree install curl
        rpm-ostree install zip
        rpm-ostree install bat
        rpm-ostree install fzf

        #ghostty is in a different repo
        . /etc/os-release
        curl -fsSL "https://copr.fedorainfracloud.org/coprs/scottames/ghostty/repo/fedora-${VERSION_ID}/scottames-ghostty-fedora-${VERSION_ID}.repo" | sudo tee /etc/yum.repos.d/_copr:copr.fedorainfracloud.org:scottames:ghostty.repo > /dev/null
        rpm-ostree refresh-md && rpm-ostree install ghostty

        # lazy git needs a different remote as well
        sudo ostree remote add --no-gpg-verify lazygit-copr https://fedorainfracloud.org
        sudo rpm-ostree install lazygit

        rpm-ostree ex apply-live # this should make the installs show up to this deployment

    {{- end -}} 

{{- else if eq .chezmoi.osRelease.id "darwin" -}}
    # all packages that need to be installed should be put in the Brew file in $(chezmoi source-path).
    check_install_darwin
{{- end -}}

echo "Setup shell"
sudo usermod --shell /bin/zsh $USER

#basalt https://basalt.page/
cargo install basalt-tui

#bit https://github.com/paulilaaso/bit
curl -sfL https://raw.githubusercontent.com/paulilaaso/bit/main/install.sh | sh


if [ -d "$HOME/.oh-my-zsh" ]; then
    echo "✅ ~/.oh-my-zsh exists"
else
    echo "⏳ downloading oh-my-zsh"
    #sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

if [ -d "$HOME/.zplug" ]; then
    echo "✅ ~/.zplug exits, skipping install"
else
    echo "⏳ downloading zplug"
    curl -sL --proto-redir -all,https https://raw.githubusercontent.com/zplug/installer/master/installer.zsh | zsh
fi

if [ -d "$HOME/powerlevel10k" ]; then
    echo "✅ ~/powerlevel10k exists, skipping install"
else
    echo "⏳ downloading powerlevel 10k"
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
fi

echo "⏳ download fonts"
#for each font you want to install dl_font, you only need to run install_fonts once
dl_font "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/MartianMono.zip"
install_fonts


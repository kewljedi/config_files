#!/bin/bash
#curl and zsh are installed by default on darwin
#https://www.chezmoi.io/user-guide/machines/linux/#combine-operating-system-and-linux-distribution-conditionals
{{- if eq .chezmoi.os "linux" -}}
    echo "Install for linux"

    {{- if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}

        echo "debian"
        sudo apt install zsh -y
        sudo apt install curl -y
        sudo apt install zip -y
        sudo apt install ghostty -y 
        sudo apt install bat -y
        sudo apt install fzf -y
        sudo apt install lazygit -y
    {{- else if eq .chezmoi.osRelease.id "fedora" -}}

        echo "fedora"
        rpm-ostree install zsh 
        rpm-ostree install tmux
        rpm-ostree install curl
        rpm-ostree install zip
        rpm-ostree install bat
        rpm-ostree install fzf

        #ghostty is in a different repo
        . /etc/os-release
        curl -fsSL "https://copr.fedorainfracloud.org/coprs/scottames/ghostty/repo/fedora-${VERSION_ID}/scottames-ghostty-fedora-${VERSION_ID}.repo" | sudo tee /etc/yum.repos.d/_copr:copr.fedorainfracloud.org:scottames:ghostty.repo > /dev/null
        rpm-ostree refresh-md && rpm-ostree install ghostty

        # lazy git needs a different remote as well
        sudo ostree remote add --no-gpg-verify lazygit-copr https://fedorainfracloud.org
        sudo rpm-ostree install lazygit

        rpm-ostree ex apply-live # this should make the installs show up to this deployment

    {{- end -}} 

    echo "Setup shell"
    sudo usermod --shell /bin/zsh $USER
{{- else if eq .chezmoi.osRelease.id "darwin" -}}
    brew install curl
    brew install zip
    brew install --cask ghostty
    brew install bat
    brew install fzf
    brew install lazygit
{{- end -}}

#basalt https://basalt.page/
cargo install basalt-tui

#bit https://github.com/paulilaaso/bit
curl -sfL https://raw.githubusercontent.com/paulilaaso/bit/main/install.sh | sh


echo "Download Oh My Zsh"
if [ -d "~/.oh-my-zsh" ]; then
    echo "~/.oh-my-zsh exists, skipping install"
else
    echo "downloading oh-my-zsh"
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

if [ -d "~/.zplug" ]; then
    echo "~/.zplug exits, skipping install"
else
    echo "downloading zplug"
    curl -sL --proto-redir -all,https https://raw.githubusercontent.com/zplug/installer/master/installer.zsh | zsh
fi

if [ -d "~/powerlevel10k"]; then
    echo "~/powerlevel10k exists, skipping install"
else
    echo "Download powerlevel 10k"
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
fi

echo "download fonts"
mkdir -p /tmp/font
curl -L https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/MartianMono.zip -o /tmp/font/font.zip
unzip /tmp/font/font.zip -d /tmp/font/

{{ if eq .chezmoi.os "linux" }}
echo "install linux fonts"
mkdir -p ~/.local/share/fonts
cp /tmp/font/*.ttf ~/.local.share/fonts
fc-cache -f -v
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
echo "install darwin fonts"
mkdir -p ~/Library/Fonts
cp /tmp/font/*.tff ~/Library/Fonts/
{{ end }}
